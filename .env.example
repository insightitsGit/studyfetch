# Shared by all three pipelines (Baseline, Prism, Relay)
DATA_DIR=./data
EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Azure Blob (optional — omit to store binaries under DATA_DIR/blobs)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=document-assets

# Optional LLM (Relay outline cleanup, Prism entity gloss). Leave empty to stay offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
